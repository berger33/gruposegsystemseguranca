{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/integration-l06/types/**/*.ts",
    ".next/integration-l06/dev/types/**/*.ts",
    ".next/integration-ext10/types/**/*.ts",
    ".next/integration-ext10/dev/types/**/*.ts",
    ".next/integration-ext07/types/**/*.ts",
    ".next/integration-ext07/dev/types/**/*.ts",
    ".next/integration-ext07-sched/types/**/*.ts",
    ".next/integration-ext07-sched/dev/types/**/*.ts",
    ".next/integration-pendency/types/**/*.ts",
    ".next/integration-pendency/dev/types/**/*.ts",
    ".next/integration-admin-entry/types/**/*.ts",
    ".next/integration-admin-entry/dev/types/**/*.ts",
    ".next/integration-ux-crm/types/**/*.ts",
    ".next/integration-ux-crm/dev/types/**/*.ts",
    ".next/integration-l04/types/**/*.ts",
    ".next/integration-l04/dev/types/**/*.ts",
    ".next/integration-f03/types/**/*.ts",
    ".next/integration-f03/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
