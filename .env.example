# PostgreSQL da aplicação (crie um usuário com privilégios mínimos e use TLS fora do host)
DATABASE_URL=postgresql://seg_app:CHANGE_ME@127.0.0.1:5432/grupo_seg_system
# Opcional: URL de um usuário de migração mais privilegiado; caso vazio, usa DATABASE_URL.
DATABASE_MIGRATION_URL=
DATABASE_POOL_SIZE=5

# Gere valores aleatórios fortes; não reutilize estes textos nem os envie pelo chat.
SITE_ADMIN_SESSION_SECRET=
SITE_ADMIN_TOKEN_MARCELO=
SITE_ADMIN_TOKEN_TI=

# Servidor Node/Next
BIND_HOST=0.0.0.0
PORT=3000
# Ative somente quando há um proxy confiável que sobrescreve os cabeçalhos X-Forwarded-*.
TRUST_PROXY=false
