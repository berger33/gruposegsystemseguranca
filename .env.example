# PostgreSQL local/de desenvolvimento (Compose vincula a porta apenas em 127.0.0.1)
POSTGRES_DB=grupo_seg_system
POSTGRES_USER=seg_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Coloque a senha hex gerada nos dois lugares; use URL encode se a senha tiver outros caracteres.
DATABASE_URL=postgresql://seg_app:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:5432/grupo_seg_system
# Opcional: URL de um usuário de migração mais privilegiado; caso vazio, usa DATABASE_URL.
DATABASE_MIGRATION_URL=
DATABASE_POOL_SIZE=5

# Gere valores aleatórios fortes; não reutilize estes textos nem os envie pelo chat.
SITE_ADMIN_SESSION_SECRET=
SITE_ADMIN_TOKEN_MARCELO=
SITE_ADMIN_TOKEN_TI=

# Servidor Node/Next
BIND_HOST=0.0.0.0
PORT=3000
# Ative somente quando há um proxy confiável que sobrescreve os cabeçalhos X-Forwarded-*.
TRUST_PROXY=false
