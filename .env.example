# PostgreSQL local/de desenvolvimento (Compose vincula a porta apenas em 127.0.0.1)
POSTGRES_DB=grupo_seg_system
POSTGRES_USER=seg_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Coloque a senha hex gerada nos dois lugares; use URL encode se a senha tiver outros caracteres.
DATABASE_URL=postgresql://seg_app:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:5432/grupo_seg_system
# Opcional: URL de um usuário de migração mais privilegiado; caso vazio, usa DATABASE_URL.
DATABASE_MIGRATION_URL=
DATABASE_POOL_SIZE=5

# Reverse-geocode employee punch coordinates. Keep the HERE key server-side;
# never expose it through NEXT_PUBLIC_* or commit the real value.
HERE_API_KEY=

# EXT-07: execução agendada da avaliação temporal (opt-in; padrão desligado).
# Intervalo em segundos (inteiro >= 1); ausente/inválido mantém o agendador desligado.
# Com 3600, são ~24 execuções/dia registradas em ext_compliance_evaluation_runs.
EXT07_EVALUATE_INTERVAL_SECONDS=
# UUID de uma identidade staff ativa (admin/ti) em cujo nome a automação age;
# é revalidada a cada tick (suspensa = execução falha fechado, zero mutação).
# Como obter o UUID: docs/APLICACAO-BANCO-DESTINO.md (Etapa 4). Exige DATABASE_URL.
EXT07_EVALUATE_IDENTITY=
# E16 (opcional) — executor da cadência. `in-process` (padrão) é o timer do
# processo: se ele cair no meio do intervalo, a execução não acontece e nada a
# retoma. `durable` grava a intenção em `durable_jobs` (migração 182) ANTES de
# executar, reivindica com lease (`FOR UPDATE SKIP LOCKED`) e conclui o
# intervalo na mesma transação do efeito: queda no meio do lease é retomada por
# outro processo sem duplicar o evento do dia, e falha ganha retry com backoff.
# Requer a migração 182 aplicada; sem ela o worker recusa ligar (não cai em
# silêncio para o modo antigo).
EXT07_SCHEDULER_MODE=in-process
# Prazo do lease em segundos (5..3600; padrão 120). É o tempo que o dono tem
# para concluir; vencido, outro processo retoma o mesmo intervalo.
EXT07_SCHEDULER_LEASE_SECONDS=
# Backoff do retry: base e teto em segundos (padrões 60 e 3600). O teto precisa
# ser >= o lease; configuração incompatível é recusada no boot.
EXT07_SCHEDULER_BACKOFF_SECONDS=
EXT07_SCHEDULER_BACKOFF_MAX_SECONDS=
# Jobs reivindicados por tick (1..50; padrão 5). Para o EXT-07 há um único job
# recorrente, então o valor útil é 1.
EXT07_SCHEDULER_BATCH_SIZE=

# Gere valores aleatórios fortes; não reutilize estes textos nem os envie pelo chat.
SITE_ADMIN_SESSION_SECRET=
# L01/SEC-05: os tokens compartilhados abaixo estão DESLIGADOS por padrão.
# Eles existem apenas como bootstrap da primeira instalação e deixam de
# funcionar sozinhos assim que houver uma conta de staff individual ativa.
# Prefira criar contas individuais; não use isto como login do dia a dia.
SITE_ADMIN_LEGACY_TOKENS=false
SITE_ADMIN_TOKEN_MARCELO=
SITE_ADMIN_TOKEN_TI=
# Tentativas de login administrativo por IP a cada 15 minutos. Padrão 8.
# Elevar apenas em ambiente de teste automatizado.
ADMIN_LOGIN_MAX_ATTEMPTS=8
# Gere uma chave exclusiva de 32 bytes em base64url e guarde fora do repositório.
# Sem ela, MFA fica indisponível (nunca degradar para senha somente).
# No Node 22: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLIENT_MFA_ENCRYPTION_KEY=
# Retome a seleção global de temas somente quando esse fluxo for priorizado novamente.
# Seleção de layout disponível para perfis autorizados; configuração legada removida.

# SMTP de notificações dos pedidos públicos; sem configuração, o lead ainda é salvo no painel.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
LEADS_NOTIFY_EMAIL=

# URL pública absoluta usada nos links de e-mail do portal do cliente
# (convite, confirmação de e-mail e recuperação de senha), sem barra final.
PUBLIC_BASE_URL=http://localhost:3000

# Diretório privado onde ficam os documentos enviados aos clientes.
# Fora de qualquer pasta pública e nunca versionado. Padrão local: <projeto>/.data/documents
CLIENT_DOCS_DIR=

# Servidor Node/Next
# Hospedagem no PC via Funnel: servir apenas no loopback; não abrir a porta 3000 na LAN.
BIND_HOST=127.0.0.1
PORT=3000
# Ative somente quando há um proxy confiável que sobrescreve os cabeçalhos X-Forwarded-*.
TRUST_PROXY=false

# IA local opt-in. Instale Ollama e baixe qwen3:1.7b antes de ativar.
# Sem modelo, base publicada ou serviço acessível, o assistente informa indisponibilidade.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
# SMTP segue sem configuração nesta etapa. Não adicione provedores ou segredos aqui.
